# Скопируйте в .env (npm run setup делает это сам). .env НЕ коммитим.

# --- Приложение ---
APP_NAME="Launchpad"
ENVIRONMENT=dev
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- База данных ---
# SQLite (по умолчанию, ничего ставить не нужно):
DATABASE_URL=sqlite:///./data/app.db
# Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# --- Модули: включайте по необходимости ---
ENABLE_AUTH=false
ENABLE_UPLOADS=false
ENABLE_AI=false

# --- Auth (ENABLE_AUTH=true) ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads (ENABLE_UPLOADS=true) ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# --- AI (ENABLE_AI=true). Любой OpenAI-совместимый API. Без ключа — mock-ответы. ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1      AI_MODEL=llama-3.3-70b-versatile
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1        AI_MODEL=openai/gpt-4o-mini
# Ollama:     AI_BASE_URL=http://localhost:11434/v1           AI_MODEL=llama3.2   AI_API_KEY=ollama

# --- Frontend (переменные с префиксом VITE_ видны в браузере — никаких секретов!) ---
# По умолчанию фронт ходит на /api через dev-proxy. Задайте, если API на другом домене:
# VITE_API_URL=https://my-api.example.com/api
