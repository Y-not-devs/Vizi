APP_NAME=Vizi
ENVIRONMENT=dev
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/app.db

ENABLE_AUTH=false
ENABLE_UPLOADS=false
ENABLE_AI=true

# Generate a private value before enabling auth.
SECRET_KEY=dev-secret-change-me-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=512

# Compose overrides this URL with http://ollama:11434/v1.
# Non-empty placeholder avoids mock mode; local Ollama needs no provider key.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3.5:4b
AI_TIMEOUT_SECONDS=280

# Optional existing Ollama cache; otherwise Compose uses a named volume.
# OLLAMA_MODELS_DIR=C:/Users/Hamza/.ollama

# Set a private key and enter the same value in the web UI API settings.
ANALYSIS_API_KEY=change-me
ANALYSIS_TIMEOUT_SECONDS=280
